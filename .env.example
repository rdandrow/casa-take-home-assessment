# Copy this file to `.env` and adjust values for your target environment.

# App host used by Playwright's baseURL (tests call page.goto('/qa_hire_q1_2026')).
PLAYWRIGHT_BASE_URL=https://app-stg.keys.casa

# Dataset-specific expected counts used by the test specs.
EXPECTED_TRANSACTION_COUNT=8
EXPECTED_DEVICE_COUNT=3
EXPECTED_ADDRESS_COUNT=4
EXPECTED_KEY_COUNT=6
MIN_CONFIRMATIONS_FOR_CONFIRMED=20
